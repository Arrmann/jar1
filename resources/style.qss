* {
    font-family: "Segoe UI Variable", "Segoe UI", Arial, sans-serif;
    font-size: 10pt;
}

QWidget {
    background-color: #05090D;
    color: #E8F4F5;
    selection-background-color: #174A54;
}

QMainWindow {
    background-color: #05090D;
}

QWidget#Sidebar {
    background-color: #080E13;
    border-right: 1px solid #18313A;
}

QPushButton {
    background-color: #0D171D;
    border: 1px solid #1A343D;
    border-radius: 9px;
    padding: 9px 13px;
    color: #D9EAEC;
    text-align: left;
}

QPushButton:hover {
    background-color: #10232B;
    border-color: #3A9EA8;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #0A1419;
}

QPushButton:checked {
    background-color: #102C34;
    border: 1px solid #5CF6F0;
    color: #F5FFFF;
}

QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #091318;
    border: 1px solid #1B3841;
    border-radius: 8px;
    padding: 7px 9px;
    color: #EAFBFC;
    selection-background-color: #17606A;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus {
    border: 1px solid #5CF6F0;
}

QComboBox QAbstractItemView {
    background-color: #0A151A;
    color: #EAFBFC;
    selection-background-color: #174A54;
    border: 1px solid #28545D;
}

QTextBrowser {
    background-color: #080F14;
    border: 1px solid #19353E;
    border-radius: 12px;
    padding: 10px;
}

QListWidget, QTableWidget, QTreeWidget {
    background-color: #080F14;
    border: 1px solid #19353E;
    border-radius: 10px;
    alternate-background-color: #0B161C;
    gridline-color: #142A31;
}

QTableWidget {
    selection-background-color: #12343D;
    selection-color: #F5FFFF;
}

QTableWidget::item {
    padding: 6px;
}

QHeaderView::section {
    background-color: #0D1B21;
    color: #91C8CC;
    border: none;
    border-bottom: 1px solid #21434C;
    padding: 8px;
    font-weight: 600;
}

QScrollBar:vertical {
    background: #05090D;
    width: 12px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #1B4650;
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #287986;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QStatusBar {
    background-color: #070D11;
    color: #7FAEB4;
    border-top: 1px solid #18313A;
}

QLabel#TitleLabel {
    font-size: 22pt;
    font-weight: 700;
    letter-spacing: 3px;
    color: #F5FFFF;
}

QLabel#SectionTitle {
    font-size: 16pt;
    font-weight: 650;
    letter-spacing: 1px;
    color: #CFFBFC;
}

QLabel#SubtitleLabel {
    color: #77949A;
}

QLabel#SidebarFooter {
    color: #44636B;
    font-size: 8pt;
    letter-spacing: 1px;
    padding-top: 12px;
}

QLabel#CommandSummary {
    color: #5CF6F0;
    background-color: #0B1E24;
    border: 1px solid #1B414A;
    border-radius: 8px;
    padding: 10px;
}

QFrame#Card {
    background-color: #080F14;
    border: 1px solid #19353E;
    border-radius: 14px;
}
